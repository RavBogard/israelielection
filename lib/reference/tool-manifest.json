  "schemaVersion": 1,
  "documents": [
    {
      "id": "tools:quiz",
      "file": "data/quiz.json",
      "path": "/match",
      "title": "Party match questions",
      "revision": "2364b60b787b157e70ec65fa9073d2140c66ced5ba7bce2b569fa6f9dbec48ce",
      "checked": "Evidence dates remain in the linked source records.",
      "blocks": [
        {
          "id": "tool-text-3c4eddd4487e1bc2",
          "kind": "text",
          "field": "core.0.prompt",
          "text": "Should Haredi (ultra-Orthodox) yeshiva students be drafted into the army?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-2a76fac570365c10",
          "kind": "text",
          "field": "core.0.context",
          "text": "Most Israeli Jews are conscripted at 18. Haredi men in full-time religious study have largely been exempt since 1948, and the Supreme Court ruled in 2024 that the exemption has no legal basis.",
          "numbers": [
            "18",
            "1948",
            "2024"
          ],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-82a290df3f71b4a5",
          "kind": "text",
          "field": "core.0.options.no-compulsion",
          "text": "No one should be compelled to serve",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-e5d336b5dac91686",
          "kind": "text",
          "field": "core.0.options.exempt-learners",
          "text": "Exempt those who study Torah full time",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-bbcd01c6f28c352d",
          "kind": "text",
          "field": "core.0.options.draft-leavers",
          "text": "Draft only those who leave yeshiva",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-f5aa0fdc027a1292",
          "kind": "text",
          "field": "core.0.options.expand-gradually",
          "text": "Raise Haredi service step by step",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3996850baaffd8fb",
          "kind": "text",
          "field": "core.0.options.draft-all",
          "text": "Everyone serves, in the army or a civilian service",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-e359368a75d5f422",
          "kind": "text",
          "field": "core.1.prompt",
          "text": "Should power shift from the courts to the Knesset and the government?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-ed339861500c518f",
          "kind": "text",
          "field": "core.1.context",
          "text": "Israel has no written constitution. Its Supreme Court can strike down laws and government decisions, and the 2023 judicial overhaul, which set out to curb it, brought months of mass protest.",
          "numbers": [
            "2023"
          ],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-c2389acb17445560",
          "kind": "text",
          "field": "core.1.options.curb",
          "text": "Yes, curb the Supreme Court's powers",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-a3998dff9c069120",
          "kind": "text",
          "field": "core.1.options.limited-override",
          "text": "Let the Knesset override the court in limited cases",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-25ea6deecc022627",
          "kind": "text",
          "field": "core.1.options.codify",
          "text": "Settle the balance in a Basic Law, a kind of constitution",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-b339030749ea70b8",
          "kind": "text",
          "field": "core.1.options.independence",
          "text": "No, keep the courts independent",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-7ef2144bdb7a1bdf",
          "kind": "text",
          "field": "core.2.prompt",
          "text": "Who should investigate the failures of October 7?",
          "numbers": [
            "10",
            "7"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-c4f8df8a101fdffd",
          "kind": "text",
          "field": "core.2.context",
          "text": "Israel's 1968 law sets up a state commission of inquiry whose members are chosen by the president of the Supreme Court. The government has proposed a different commission whose members the court would not choose.",
          "numbers": [
            "1968"
          ],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-b11177ce9fb61c1a",
          "kind": "text",
          "field": "core.2.options.other-commission",
          "text": "A commission set up outside the 1968 law",
          "numbers": [
            "1968"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-f86ad6175acd21f6",
          "kind": "text",
          "field": "core.2.options.independent-unset",
          "text": "An independent inquiry; the exact form can wait",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-7b420cf46552f438",
          "kind": "text",
          "field": "core.2.options.state-commission",
          "text": "A state commission of inquiry under the 1968 law",
          "numbers": [
            "1968"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-237a9fea8d658e3b",
          "kind": "text",
          "field": "core.3.prompt",
          "text": "Should Israel annex land in the occupied West Bank?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-5f8086c24c47ed8e",
          "kind": "text",
          "field": "core.3.context",
          "text": "Israel has held the West Bank since 1967 without annexing it. About half a million Israeli settlers and some three million Palestinians live there. Annexation would apply Israeli law to the land.",
          "numbers": [
            "1967"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-843901eb6275cc92",
          "kind": "text",
          "field": "core.3.options.annex-all",
          "text": "Annex the whole West Bank",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-cb38a8d589c356ae",
          "kind": "text",
          "field": "core.3.options.annex-part",
          "text": "Annex Area C or chosen areas",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-11b2bebdf283e5fc",
          "kind": "text",
          "field": "core.3.options.sovereignty-not-bills",
          "text": "Back sovereignty in principle, but not by law now",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-ca15a23f4ee65928",
          "kind": "text",
          "field": "core.3.options.settle-no-annex",
          "text": "Expand settlements without annexing",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-008e7e1bb5e31a88",
          "kind": "text",
          "field": "core.3.options.separation",
          "text": "Separate from the Palestinians",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-7ca9a3f9d15e7225",
          "kind": "text",
          "field": "core.3.options.no-annexation",
          "text": "No annexation; work toward a Palestinian state",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-79c16ffefb1f62ed",
          "kind": "text",
          "field": "core.4.prompt",
          "text": "Should there be a Palestinian state?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-e103168e10cccbe7",
          "kind": "text",
          "field": "core.4.context",
          "text": "A Palestinian state beside Israel has been the aim of most international peace plans since the 1990s. Most lists running in 2026 oppose one; a few support it.",
          "numbers": [
            "1990",
            "2026"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-346cf2bea883cd1f",
          "kind": "text",
          "field": "core.4.options.oppose",
          "text": "No, oppose a Palestinian state",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-676248b17feddfd5",
          "kind": "text",
          "field": "core.4.options.not-on-agenda",
          "text": "Not now; it is not on the agenda",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-fe90b2eb23e0fa56",
          "kind": "text",
          "field": "core.4.options.separation",
          "text": "Separation as part of a regional deal",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-ee245790234f1a31",
          "kind": "text",
          "field": "core.4.options.support",
          "text": "Yes, support a Palestinian state",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-954e91ac4278732e",
          "kind": "text",
          "field": "core.5.prompt",
          "text": "Who should run marriage, conversion and the rules for Shabbat?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-65ef989da1807cd7",
          "kind": "text",
          "field": "core.5.context",
          "text": "Israel has no civil marriage: Jews marry through the Orthodox Chief Rabbinate, and many couples marry abroad instead. The rabbinate also controls conversion, and Shabbat rules such as public transport are set nationally.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-ac8744243bbcca3b",
          "kind": "text",
          "field": "core.5.options.orthodox",
          "text": "Keep them in Orthodox hands",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3c6322ce38d889a2",
          "kind": "text",
          "field": "core.5.options.civil-local",
          "text": "Allow civil marriage, and let towns set Shabbat rules",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-2fb299229b86a72a",
          "kind": "text",
          "field": "core.5.options.civil-pluralist",
          "text": "Allow civil marriage and recognise non-Orthodox conversion",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-16f7e929e65df794",
          "kind": "text",
          "field": "core.6.prompt",
          "text": "What should economic policy put first?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-c679d68109133cb4",
          "kind": "text",
          "field": "core.6.context",
          "text": "The cost of living is among Israelis' top worries. The lists' economic priorities can coexist rather than run from one end to another, so the match here is on the priority you put first.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-b95a4668fe76b6d2",
          "kind": "text",
          "field": "core.6.options.market",
          "text": "Free markets and a smaller state",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-b2a6a7d9c8f7b88b",
          "kind": "text",
          "field": "core.6.options.living-costs",
          "text": "Lower living costs and narrower gaps",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-989947bf5ab28033",
          "kind": "text",
          "field": "core.6.options.reward-service",
          "text": "Rewarding those who serve in the army or reserves",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-ef27d9c5fcd25001",
          "kind": "text",
          "field": "core.6.options.own-community",
          "text": "Budgets for communities that have been left behind",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-e5b21fdf2bae21f9",
          "kind": "text",
          "field": "deeper.0.prompt",
          "text": "Should young Haredi men who have left yeshiva be required to serve?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-89ed0faee4d56cee",
          "kind": "text",
          "field": "deeper.0.context",
          "text": "Even some lists that defend the exemption for full-time students disagree over men who are no longer studying.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-79aae069253d9cad",
          "kind": "text",
          "field": "deeper.0.options.require",
          "text": "Yes, require them to serve",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-ffb011b70f1a9f95",
          "kind": "text",
          "field": "deeper.0.options.oppose",
          "text": "No compulsory service",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-463b96486308a675",
          "kind": "text",
          "field": "deeper.1.prompt",
          "text": "In a service framework, military or civilian, who should be exempt?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3f39f04e772f8631",
          "kind": "text",
          "field": "deeper.1.context",
          "text": "The draft plans differ most on who would still be exempt.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-163f973e87a4312e",
          "kind": "text",
          "field": "deeper.1.options.none",
          "text": "No one: no exemptions or quotas",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-dbb6636e397659c8",
          "kind": "text",
          "field": "deeper.1.options.outstanding",
          "text": "A small number of outstanding scholars",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-d282e9ed23452de3",
          "kind": "text",
          "field": "deeper.1.options.learners",
          "text": "Everyone studying in yeshiva full time",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-4f83ec9bd8d5166d",
          "kind": "text",
          "field": "deeper.2.prompt",
          "text": "Should the 2025 law that gave politicians more say in choosing judges be repealed?",
          "numbers": [
            "2025"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-068b9fc1a41dbf07",
          "kind": "text",
          "field": "deeper.2.context",
          "text": "The March 2025 law replaced the Israel Bar Association's two seats on the committee that selects judges with public representatives chosen by the coalition and the opposition. It takes effect in the next Knesset.",
          "numbers": [
            "2025",
            "3"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-40c06bfe36613ef1",
          "kind": "text",
          "field": "deeper.2.options.repeal",
          "text": "Repeal and replace it",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-9dae1c93a3cbbd6a",
          "kind": "text",
          "field": "deeper.2.options.enacted",
          "text": "Keep it",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-6d1c67f657782c64",
          "kind": "text",
          "field": "deeper.3.prompt",
          "text": "Should the Knesset be able to pass again a law the Supreme Court has struck down?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-6011b2dbc48bed8d",
          "kind": "text",
          "field": "deeper.3.context",
          "text": "An \"override clause\" was the most contested part of the 2023 overhaul. The answers differ on how large a majority it would need.",
          "numbers": [
            "2023"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3138ba3086d2ac55",
          "kind": "text",
          "field": "deeper.3.options.61",
          "text": "Yes, with a simple majority of 61",
          "numbers": [
            "61"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-7eb3e5b598b6a744",
          "kind": "text",
          "field": "deeper.3.options.oppose",
          "text": "No override",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-9348415f87b9d7c5",
          "kind": "text",
          "field": "deeper.3.options.supermajority",
          "text": "Only with a special majority, 70 MKs or more",
          "numbers": [
            "70"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-db88bbfe69203656",
          "kind": "text",
          "field": "deeper.4.prompt",
          "text": "Should the courts keep \"reasonableness\" as grounds to overturn government decisions?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-965fb5e8fc4f319d",
          "kind": "text",
          "field": "deeper.4.context",
          "text": "In 2023 the Knesset abolished the standard for decisions by the cabinet and ministers; the Supreme Court struck that law down in 2024.",
          "numbers": [
            "2023",
            "2024"
          ],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-2b66dfe5dead1db0",
          "kind": "text",
          "field": "deeper.4.options.narrow",
          "text": "Keep it, but narrow it",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3e09b11e8ccf487b",
          "kind": "text",
          "field": "deeper.4.options.abolish",
          "text": "Abolish it for decisions by the cabinet and ministers",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-3ec7079f12062512",
          "kind": "text",
          "field": "deeper.5.prompt",
          "text": "Should couples be able to marry in a civil ceremony inside Israel?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-5952076c3edaec91",
          "kind": "text",
          "field": "deeper.5.context",
          "text": "Today a civil marriage performed abroad is registered in Israel, but none can be performed in the country.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-12ea257121d72586",
          "kind": "text",
          "field": "deeper.5.options.allow",
          "text": "Yes, allow a civil option",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-b9a1bd43792129d5",
          "kind": "text",
          "field": "deeper.5.options.oppose",
          "text": "No, keep marriage religious",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-68ddee386e6697b8",
          "kind": "text",
          "field": "deeper.6.prompt",
          "text": "Should towns be able to run public transport on Shabbat?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-bb1329dc2a9a1e66",
          "kind": "text",
          "field": "deeper.6.context",
          "text": "Most buses and trains stop from Friday evening to Saturday evening. A few cities run limited services of their own.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-1e690fae6efddca7",
          "kind": "text",
          "field": "deeper.6.options.local",
          "text": "Yes, let each town decide",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-9d636fd24fa2f650",
          "kind": "text",
          "field": "deeper.6.options.keep",
          "text": "No, keep the current Shabbat rules",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": true
        },
        {
          "id": "tool-text-99ca82cf086e5e26",
          "kind": "text",
          "field": "deeper.7.prompt",
          "text": "Should Israel recognise conversions to Judaism done outside the Orthodox establishment?",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-8f1a8c1fe8ab4399",
          "kind": "text",
          "field": "deeper.7.context",
          "text": "Recognition decides who is Jewish under Israeli law for marriage and burial, which matters to many Reform and Conservative Jews.",
          "numbers": [],
          "links": [],
          "names": [],
          "negated": false
        },
        {
          "id": "tool-text-7c1f300e95c355fb",

# Names only. All new capabilities default off. No credentials or services are included.
POLITICAL_RECORD_DATABASE_URL=
POLITICAL_RECORD_BLOB_TOKEN=
POLITICAL_RECORD_READ_ENABLED=
POLITICAL_RECORD_PUBLIC_READ_ENABLED=
POLITICAL_RECORD_SHADOW_ENABLED=
POLITICAL_PLATFORM_COLLECT_ENABLED=
POLITICAL_PLATFORM_NAMESPACE=
PUBLIC_V2_API_ENABLED=
PUBLIC_API_CURSOR_SECRET=
SUBSCRIPTIONS_ENABLED=
SUBSCRIPTION_DELIVERY_ENABLED=
SUBSCRIPTION_ENCRYPTION_KEY=
SUBSCRIPTION_TOKEN_SECRET=
SUBSCRIPTION_SITE_ORIGIN=
SUBSCRIPTION_CONSENT_VERSION=
RESEND_API_KEY=
RESEND_FROM=
RESEND_DOMAIN_VERIFIED=
RESEND_WEBHOOK_SECRET=
# Existing shared Redis/QStash variables are reused; never copy their values into this file.
KV_REST_API_URL=
KV_REST_API_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
ELECTION_LIFECYCLE_WORKER_URL=

# Future-election registry: separate read/discovery/activation switches, all off by default.
POLITICAL_ELECTION_REGISTRY_ENABLED=
POLITICAL_ELECTION_DISCOVERY_ENABLED=
POLITICAL_ELECTION_ACTIVATION_ENABLED=
POLITICAL_WORKSPACE_SITE_ORIGIN=
# A contract must first pass actual Knesset metadata and primary field-documentation qualification.
POLITICAL_PARLIAMENT_COLLECT_ENABLED=
POLITICAL_PARLIAMENT_CONTRACT_ID=

# Optional public projected archive CLI origin, never a private capture destination.
PUBLIC_ARCHIVE_SITE_ORIGIN=

# Private categorical operations state only; no destructive recovery or external messages.
PLATFORM_MONITOR_NAMESPACE=
PLATFORM_MONITOR_STORE_ENABLED=
# GitHub repository variable (not a secret); new cron remains off unless explicitly true.
PLATFORM_MONITOR_SCHEDULE_ENABLED=
PLATFORM_MONITOR_PREVIEW_ORIGIN=
# Optional owned-preview browser bypass secret; never sent to Globalping.
PLATFORM_MONITOR_PREVIEW_BYPASS=
# Local headless browser override, e.g. installed Edge; CI uses installed Chromium.
PLATFORM_MONITOR_BROWSER_CHANNEL=

# Automatic publication producer; existing Gemini provider only, default off.
POLITICAL_PUBLICATION_PRODUCER_ENABLED=
GEMINI_API_KEY=
GEMINI_MODEL=
# GitHub variable: categorical stored-source/producer CI failure signal, default off.
PLATFORM_MONITOR_SOURCE_STATUS_ENABLED=
